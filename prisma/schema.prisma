// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


model User {
  id        String   @id @default(uuid())
  username  String   @unique
  email     String?
  password  String
  name      String
  reputation Int      @default(0)
  createdAt DateTime @default(now())
  
  watchlists Watchlist[]
  posts      Post[]
  comments   Comment[]
  likes      Like[]
  votes      Vote[]
  
  @@map("users")
}

model Watchlist {
  id          String   @id @default(uuid())
  userId      String
  stockSymbol String
  stockName   String
  createdAt   DateTime @default(now())
  
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@unique([userId, stockSymbol])
  @@map("watchlists")
}

model Stock {
  id          String   @id @default(uuid())
  symbol      String   @unique
  name        String
  market      String   // KOSPI, KOSDAQ, SP500, NASDAQ
  sector      String?
  marketCap   BigInt?
  price       Float
  change      Float
  changePercent Float
  createdAt   DateTime @default(now())
  
  posts Post[]
  votes Vote[]
  
  @@map("stocks")
}

enum Sentiment {
  BULLISH
  BEARISH
}

model Post {
  id        String     @id @default(uuid())
  title     String
  content   String
  category  String     @default("FREE") // ANALYSIS, NEWS, HUMOR, QNA, FREE
  sentiment Sentiment? // BULLISH, BEARISH
  viewCount Int        @default(0)
  userId    String
  stockId   String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  stock    Stock     @relation(fields: [stockId], references: [id], onDelete: Cascade)
  comments Comment[]
  likes    Like[]
  
  @@map("posts")
}

model Comment {
  id        String   @id @default(uuid())
  content   String
  userId    String
  postId    String
  parentId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  post      Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  parent    Comment?  @relation("CommentToComment", fields: [parentId], references: [id], onDelete: Cascade)
  children  Comment[] @relation("CommentToComment")
  likes     Like[]
  
  @@map("comments")
}

model Like {
  id        String  @id @default(uuid())
  userId    String
  postId    String?
  commentId String?
  
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  post    Post?    @relation(fields: [postId], references: [id], onDelete: Cascade)
  comment Comment? @relation(fields: [commentId], references: [id], onDelete: Cascade)
  
  @@unique([userId, postId, commentId])
  @@map("likes")
}

model Vote {
  id        String    @id @default(uuid())
  userId    String
  stockId   String
  type      Sentiment // BULLISH, BEARISH
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  stock     Stock     @relation(fields: [stockId], references: [id], onDelete: Cascade)
  
  @@unique([userId, stockId]) // One vote per stock per user (can update)
  @@map("votes")
}